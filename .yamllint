extends: default

rules:
  line-length: disable
  comments-indentation: disable
  document-start: disable
  # `on:` do GitHub Actions é lido como booleano no YAML 1.1; sem isto, todo
  # workflow gera warning falso.
  truthy:
    check-keys: false
    allowed-values: ["true", "false", "yes", "no"]

ignore: |
  charts/*/charts/
  .venv/
