# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/

# Bundle e artefatos de build
dist/
build/
*.tar.zst
*.images.tar
bundle/

# Estado local do cluster (nunca versionar)
runtime/
*.kubeconfig
kubeconfig

# Segredos e ambiente
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
*.secret.yaml

# Dados do lake (nunca entram no git; vivem no Garage)
raw/
derived/
backup/

# OS / editor
.DS_Store
.vscode/
.idea/

# Banco local de desenvolvimento do catálogo (nunca versionar)
*.db
.dev-catalog.db

# Charts vendorizados do umbrella (gerados por `helm dependency update`)
charts/*/charts/
charts/*/Chart.lock

# Imagens vendorizadas do módulo observability: ~1,6 GB. O tarball NÃO vai para
# o git (é artefato de bundle, não fonte). Os charts .tgz vão, porque são texto
# e definem a instalação.
modules/*/vendor/images.tar
modules/*/vendor/SHA256SUMS
