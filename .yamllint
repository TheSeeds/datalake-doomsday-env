extends: default

rules:
  line-length: disable
  comments-indentation: disable
  # Comentario "#:" e valido em values.yaml (distingue "campo de values" de
  # "nota para humano"). A regra quer "# ", que quebraria essa convencao.
  comments:
    min-spaces-from-content: 1
    require-starting-space: false
  document-start: disable
  # `on:` do GitHub Actions é lido como booleano no YAML 1.1; sem isto, todo
  # workflow gera warning falso.
  truthy:
    check-keys: false
    allowed-values: ["true", "false", "yes", "no"]

ignore: |
  charts/*/charts/
  .venv/
  # Templates Helm sao Go-template, nao YAML: `{{ }}` e sintaxe de template e
  # o arquivo pode comecar com `{{- /* comentario */ -}}`, que o yamllint le
  # como erro de sintaxe. Quem valida template e o `helm lint`.
  charts/*/templates/
  charts/*/Chart.yaml
